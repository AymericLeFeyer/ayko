# Encrypts stored secrets. Required outside mock mode: openssl rand -hex 32
# Keep it safe: losing it makes stored secrets unreadable.
AYKO_MASTER_KEY=

# Serves demo data, a fake Ollama and a fake MCP server. No hardware needed.
AYKO_MOCK=false

# URL users type to reach Ayko. https:// turns the Secure cookie flag on.
AYKO_PUBLIC_URL=http://localhost:3100

AYKO_HOST=0.0.0.0
AYKO_PORT=3100
AYKO_DATA_DIR=./data

# debug | info | warn | error. Only the startup value: then set in the backoffice.
AYKO_LOG_LEVEL=info

# Comma-separated origins allowed by CORS. Empty means same-origin only.
AYKO_CORS_ORIGINS=
