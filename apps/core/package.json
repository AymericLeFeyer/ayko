    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
